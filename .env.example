# Do NOT put real values in this file or commit real secrets to git.
# In Replit: open the "Secrets" tab (padlock icon) and add these two keys
# there instead — main.py reads them from the environment.

HIGHRISE_ROOM_ID=your-room-id-here
HIGHRISE_BOT_TOKEN=your-bot-api-token-here

# Optional. Replit sets PORT automatically; only override locally if needed.
# PORT=8080

# Optional AI (see README "AI setup"). Groq first, OmniRoute as fallback.
# GROQ_API_KEY=your-free-groq-key
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=ddgw/gpt-5.4-mini
# OMNIROUTE_FALLBACK_MODELS=ddgw/gpt-5.6-luna,ddgw/gpt-5-mini
