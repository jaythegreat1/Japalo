# Highrise: room ID and bot API token from https://highrise.game/en/developer
HIGHRISE_ROOM_ID=
HIGHRISE_API_TOKEN=

# OmniRoute: the AI gateway (run `omniroute` on the same machine as the bot)
OMNIROUTE_URL=http://localhost:20128/v1
# Copy from OmniRoute Dashboard -> Endpoints (needed if API keys are required)
OMNIROUTE_API_KEY=
# "auto" lets OmniRoute pick and fall back; or name a model from !models
OMNIROUTE_MODEL=auto
# Models to try, in order, when the main one fails (comma separated, e.g. a model
# from a provider you connected with your own key). Empty = no fallback.
OMNIROUTE_FALLBACK_MODELS=
OMNIROUTE_TIMEOUT=45

# Bot
BOT_NAME=Japalo
# Highrise usernames allowed to use !model !models !learn !forget (comma separated)
BOT_OWNERS=
BOT_PREFIX=!
BOT_USER_COOLDOWN=4
BOT_MAX_HISTORY=12
BOT_DATA_DIR=data
# Numbered emote list (number = position in the list); defaults to bot/emotes.json
# BOT_EMOTES_FILE=my_emotes.json
# BOT_SYSTEM_PROMPT=You are {name}, ...
